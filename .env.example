# cp .env.example .env.local 후 채울 것. 프로덕션은 Vercel에서 설정.

# Supabase — Dashboard > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-publishable-key-here
SUPABASE_SECRET_KEY=sb_secret_your-secret-key-here

# 로컬: http://localhost:3000 / 프로덕션: 실제 도메인
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 32바이트 hex. 생성 (PowerShell): [guid]::NewGuid().ToString('N') + [guid]::NewGuid().ToString('N')
COOKIE_SECRET=replace-with-64-char-hex-string

# Google AdSense — 비워두면 광고 + 메타 태그 비활성 (ads.txt는 public/ads.txt 정적 파일로 상시 제공)
# NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
# NEXT_PUBLIC_ADSENSE_SLOT_DESKTOP_LEFT=1234567890
# NEXT_PUBLIC_ADSENSE_SLOT_DESKTOP_RIGHT=1234567890
# NEXT_PUBLIC_ADSENSE_SLOT_MOBILE_BOTTOM=1234567890

# Microsoft Clarity (heatmaps + session recordings) — 전환 계측 스위치와 별도, 이 ID를 비울 때만 비활성
# NEXT_PUBLIC_CLARITY_PROJECT_ID=abc1234567

# Google Analytics 4 — 비워두면 비활성. UA-... 구식 ID 아님, G-... 형식
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# 전환 계측 — 017 마이그레이션과 docs/conversion-measurement.md 설정 후 두 값을 true로 변경
MEASUREMENT_ENABLED=false
NEXT_PUBLIC_MEASUREMENT_ENABLED=false

# ChatGPT Ads 전용 Pixel ID는 공개 설정, Conversions API 키는 서버 전용 (일반 OpenAI API 키와 다름)
NEXT_PUBLIC_CHATGPT_ADS_PIXEL_ID=
CHATGPT_ADS_API_KEY=
NEXT_PUBLIC_CHATGPT_ADS_CONVERSION_EVENTS=event_created
CHATGPT_ADS_VALIDATE_ONLY=false

# 개발·미리보기에서 실험할 때만 true. 운영에서는 false
NEXT_PUBLIC_MEASUREMENT_DEBUG=false

# 광고 전환 재전송 작업 인증. 비워두면 /api/measurement/flush 호출 불가
CRON_SECRET=
