{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/scripts/hooks/pre-bash-block-destructive-git.js\""
          }
        ],
        "description": "Block destructive git commands (reset --hard, restore, checkout HEAD --, clean -f, push --force)"
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/scripts/hooks/pre-bash-block-main-commit.js\""
          }
        ],
        "description": "Block direct commits and pushes to main/master: use a feature branch and a PR"
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/scripts/hooks/pre-bash-block-human-only.js\""
          }
        ],
        "description": "Block commands reserved for humans (supabase db push, supabase db reset)"
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/scripts/hooks/pre-edit-block-large-delete.js\""
          }
        ],
        "description": "Block Edit/Write that delete >100 lines in a single call"
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/scripts/hooks/pre-edit-block-dark-class.js\""
          }
        ],
        "description": "Block Edit/Write that introduce Tailwind `dark:` classes (dark mode is disabled project-wide)"
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/scripts/hooks/pre-edit-block-new-comments.js\""
          }
        ],
        "description": "Block Edit/Write that add code comments in src/ and scripts/ (project rule: zero comments, directives allowed)"
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/scripts/hooks/post-edit-typecheck.js\"",
            "timeout": 90
          }
        ],
        "description": "Type-check .ts/.tsx after edits and return errors to the agent (exit 2)"
      }
    ]
  }
}
